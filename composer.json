{
  "name": "itmosoft/laravel-b2b",
  "description": "B2B commerce account management for Laravel applications, with company purchasing policies, buyer memberships, order controls, and payment terms.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.5|^12.0"
  },
  "autoload": {
    "psr-4": {
      "ITMOSOFT\\B2B\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ITMOSOFT\\B2B\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ITMOSOFT\\B2B\\B2BServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
